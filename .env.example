# =========================================================================
# INVORA — ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env lalu sesuaikan dengan kredensial Supabase Anda
# =========================================================================

# Database Supabase (PostgreSQL)
# Format Session Pooler (port 5432):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Contoh (ganti [PROJECT_REF], [PASSWORD], dan [REGION] dengan data Anda):
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# =========================================================================
# Google Workspace OAuth 2.0 (Khusus domain @idstar.group)
# Buat kredensial di: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:
# - Development: http://localhost:3000/api/auth/google/callback
# - Production : https://[domain-invora-anda].vercel.app/api/auth/google/callback
# =========================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# =========================================================================
# SMTP Email Service (Pengiriman Email Nyata untuk Reset Kata Sandi & Notifikasi)
#
# Opsi 1: Google Workspace / Gmail (Disarankan untuk @idstar.group)
# 1. Buka Akun Google -> Keamanan -> Aktifkan Verifikasi 2 Langkah
# 2. Cari "Sandi Aplikasi" (App Password) di https://myaccount.google.com/apppasswords
# 3. Buat sandi baru untuk aplikasi "INVORA" (menghasilkan 16 huruf acak)
# =========================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifikasi@idstar.group
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM="INVORA IDStar <notifikasi@idstar.group>"

# Opsi 2: Layanan SMTP Kustom / Brevo / SendGrid / Mailgun (Gunakan Port 587)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-password
# SMTP_FROM="INVORA IDStar <noreply@idstar.group>"


